# test runs never reach the repo; step 6 removes this line.
data/state.db

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Personal Claude Code settings (shared ones in .claude/settings.json ARE committed)
.claude/settings.local.json
